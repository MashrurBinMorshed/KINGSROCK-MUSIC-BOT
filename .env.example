# =====================================================================
#  KINGSROCK configuration
#  Copy this file to ".env" and fill in the values. NEVER commit .env.
#  On the cloud server, the same variables go in /etc/kingsrock/kingsrock.env
# =====================================================================

# --- Discord (required) -------------------------------------------------
# Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=
# Developer Portal > your application > General Information > Application ID
DISCORD_CLIENT_ID=
# Optional. Your TEST server ID. Only used to register commands instantly in one
# server during development. Leave EMPTY in production (global commands).
DISCORD_GUILD_ID=

# --- Runtime --------------------------------------------------------------
# production | development   ("npm run dev" forces development)
NODE_ENV=production
# debug | info | warn | error
LOG_LEVEL=info

# --- Audio ----------------------------------------------------------------
# Leave as "ffmpeg"/"ffprobe" if FFmpeg is on PATH, otherwise give full paths.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Opus bitrate sent to Discord in kbps (32-256). 96 is a good default for music.
AUDIO_BITRATE=96
# Volume when the bot joins (1-100). 100 = original loudness.
DEFAULT_VOLUME=50
# Give up on a stream that has not started after this many seconds.
STREAM_START_TIMEOUT_SECONDS=20

# --- Player -----------------------------------------------------------------
# Leave the voice channel after this long with nothing playing / paused.
INACTIVITY_TIMEOUT_SECONDS=300
# Pause, then leave, when nobody is listening for this long.
ALONE_TIMEOUT_SECONDS=60
MAX_QUEUE_SIZE=200

# --- Music providers ----------------------------------------------------------
# Comma separated: direct,audius,radio,archive,jamendo
ENABLED_PROVIDERS=direct,audius,radio,archive,jamendo
# Used when /play gets plain text: audius | archive | jamendo | radio | youtube
# Leave empty for the default (youtube if YOUTUBE_ENABLED=true, else audius).
DEFAULT_SEARCH_PROVIDER=
# Identifies KINGSROCK to the Audius API (no key required).
AUDIUS_APP_NAME=KINGSROCK
# Optional, free: https://devportal.jamendo.com  (Jamendo is skipped when empty)
JAMENDO_CLIENT_ID=
# --- YouTube (OPT-IN) ------------------------------------------------------
# Uses yt-dlp. Against YouTube's Terms of Service: you are responsible for its use.
# YouTube often blocks cloud/datacenter IPs ("Sign in to confirm you're not a bot").
# When enabled, plain-text /play searches YouTube first (unless DEFAULT_SEARCH_PROVIDER is set).
YOUTUBE_ENABLED=false
# "yt-dlp" if it's on PATH, otherwise the full path to yt-dlp(.exe)
YTDLP_PATH=yt-dlp
# Optional Netscape-format cookies file (helps with "not a bot" blocks; the account can get restricted)
YOUTUBE_COOKIES_FILE=
# Seconds to wait for provider APIs.
PROVIDER_TIMEOUT_SECONDS=10
# Security: keep false. true allows links to LAN/localhost (local testing only).
ALLOW_PRIVATE_NETWORK_URLS=false

# --- Storage / monitoring ---------------------------------------------------
# Where per-server settings and the instance lock are stored.
DATA_DIR=data
# Optional health endpoint (0 = disabled). Example: 8080 -> http://127.0.0.1:8080/health
HEALTH_PORT=0
HEALTH_HOST=127.0.0.1
