{
  "name": "kingsrock",
  "version": "1.0.0",
  "description": "KINGSROCK - a lightweight, cloud-hosted Discord music bot for esports communities.",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch-path=src src/index.js --dev",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "register": "node src/deploy-commands.js",
    "register:guild": "node src/deploy-commands.js --guild",
    "register:global": "node src/deploy-commands.js --global",
    "unregister:guild": "node src/deploy-commands.js --guild --clear",
    "doctor": "node src/doctor.js",
    "measure": "node scripts/measure.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10"
  }
}
